generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Chain {
  id          String  @id @default(ulid())
  name        String?
  description String?
  chainLength Int     @default(0)
  isMain      Boolean @default(false)

  steps     Step[]
  instances ChainInstance[]

  usedBySteps Step[] @relation("childChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChainInstance {
  id String @id @default(ulid())

  templateId String
  chain      Chain  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  status       String  @default("PENDING")
  handlerUrl   String?
  chainPayload Json?
  error        Json?

  stepInstances StepInstance[] @relation("ChainToStep")

  parentStepInstanceId String?
  parentStepInstance   StepInstance? @relation("SubChainRelation", fields: [parentStepInstanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([status])
}

model Step {
  id        String  @id @default(ulid())
  bizKey    String? 
  name      String?
  sortOrder Int     @default(0) 
  isAuto    Boolean @default(true) 

  chainId String
  chain   Chain  @relation(fields: [chainId], references: [id], onDelete: Cascade)

  handlerUrl String?

  subChainId String?
  subChain   Chain?  @relation("childChain", fields: [subChainId], references: [id])

  instances StepInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bizKey, name])
  @@index([chainId])
  @@index([sortOrder])
}

model StepInstance {
  id        String @id @default(ulid())
  sortOrder Int    @default(0) 

  stepId String
  step   Step   @relation(fields: [stepId], references: [id])

  chainInstanceId String
  chainInstance   ChainInstance @relation("ChainToStep", fields: [chainInstanceId], references: [id], onDelete: Cascade)

  childChainInstances ChainInstance[] @relation("SubChainRelation")

  status String @default("PENDING")

  payload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainInstanceId])
  @@index([stepId])
  @@index([sortOrder])
}
