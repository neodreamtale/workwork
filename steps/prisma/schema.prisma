generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Step {
  id               String   @id @default(ulid())
  name             String?
  previous         String?
  next             String?
  chainId          String
  chainPos         Int
  parentId         String?
  parent           Step?    @relation("include", fields: [parentId], references: [id])
  includeSteps     Step[]   @relation("include")
  currentStepIndex Int?
  payload          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([chainId, chainPos])
  @@index([parentId])
  @@index([chainId])
}

model Chain {
  id        String   @id @default(ulid())
  name      String?
  nowStepId String?
  chainPos  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
