generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Step {
  id               String   @id @default(ulid())
  name             String?
  previous         String?
  next             String?
  chain            Chain    @relation(fields: [chainId], references: [id])
  chainId          String   @default("")
  parent           Step?    @relation("include", fields: [parentId], references: [id])
  parentId         String   @default("")
  includeSteps     Step[]   @relation("include")
  currentStepIndex Int?
  payload          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([chainId, parentId])
  @@index([parentId])
  @@index([chainId])
}

model Chain {
  id          String   @id @default(ulid())
  name        String?
  nowStepId   String?
  chainPos    Int
  chainLength Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  steps       Step[]
}
