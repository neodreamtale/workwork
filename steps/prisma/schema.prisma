generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
}

model Chain {
  id          String  @id @default(ulid())
  name        String?
  description String?
  chainLength Int     @default(0)
  isMain      Boolean @default(false)

  steps     Step[]
  instances ChainInstance[]

  // 反向关联：这个模板被哪些步骤作为“子流程”引用了
  usedBySteps Step[] @relation("childChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChainInstance {
  id String @id @default(ulid())

  // 它是根据哪个模板创建的
  templateId String
  chain      Chain  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // 运行状态：PENDING(待触发), RUNNING(进行中), PAUSED(挂起), COMPLETED(完成), FAILED(失败), CANCELLED(取消)
  status       String  @default("PENDING")
  // 全局默认回调地址：如果步骤没有自己设置，将使用此地址
  handlerUrl   String?
  // 整个流程运行期间产生的全局数据
  chainPayload Json?
  // 错误信息池：Map<stepId, errorTip>
  error        Json?

  // 该工作流包含的所有节点实例
  stepInstances StepInstance[] @relation("ChainToStep")

  // 【新增：双向指针】如果这是个子流程实例，它是由哪个父节点实例派生出来的
  parentStepInstanceId String?
  parentStepInstance   StepInstance? @relation("SubChainRelation", fields: [parentStepInstanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([status])
}

model Step {
  id        String  @id @default(ulid())
  bizKey    String? // 业务主键，用于逻辑绑定 (例如: CALC_TAX)
  name      String?
  sortOrder Int     @default(0) // 排序序号
  isAuto    Boolean @default(true) // 是否自动执行下一步

  // 归属的 Chain
  chainId String
  chain   Chain  @relation(fields: [chainId], references: [id], onDelete: Cascade)

  // 远程回调地址：如果配置了此项，执行时将向该地址发送 POST 请求
  handlerUrl String?

  // 引用子流程关系 (如果这个步骤是要调起另一个工作流模板)
  subChainId String?
  subChain   Chain?  @relation("childChain", fields: [subChainId], references: [id])

  instances StepInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bizKey, name])
  @@index([chainId])
  @@index([sortOrder])
}

model StepInstance {
  id        String @id @default(ulid())
  sortOrder Int    @default(0) // 快照当时的序号

  stepId String
  step   Step   @relation(fields: [stepId], references: [id])

  // 归属的工作流实例
  chainInstanceId String
  chainInstance   ChainInstance @relation("ChainToStep", fields: [chainInstanceId], references: [id], onDelete: Cascade)

  // 【新增：双向指针的反向关系】作为父节点，派生出的子流程实例们
  childChainInstances ChainInstance[] @relation("SubChainRelation")

  // 该步骤的执行状态：PENDING(未开始), READY(待认领), RUNNING(处理中), COMPLETED(完成), FAILED(异常), SKIPPED(跳过)
  status String @default("PENDING")

  // 业务数据
  payload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainInstanceId])
  @@index([stepId])
  @@index([sortOrder])
}
