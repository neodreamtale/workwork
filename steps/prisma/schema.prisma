generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Chain {
  id          String  @id @default(ulid())
  name        String?
  description String?
  chainLength Int     @default(0)

  steps     Step[]
  instances ChainInstance[]

  // 反向关联：这个模板被哪些步骤作为“子流程”引用了
  usedBySteps Step[] @relation("childChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChainInstance {
  id String @id @default(ulid())

  // 它是根据哪个模板创建的
  templateId String
  chain      Chain  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // 运行状态：PENDING(待触发), RUNNING(进行中), PAUSED(挂起), COMPLETED(完成), FAILED(失败), CANCELLED(取消)
  status    String  @default("PENDING")
  nowStepId String? // 当前跑到哪一步了 (指向 Step 的 ID)

  // 整个流程运行期间产生的全局数据
  chainPayload  Json?
  stepInstances StepInstance[]

  // 如果这是一个子流程实例，它是被哪个父步骤实例调起的？
  parentStepInstances StepInstance[] @relation("ParentStep")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([templateId])
  @@index([status])
}

model Step {
  id   String  @id @default(ulid())
  name String?

  // 流程结构：上下级指针
  previousId String?
  nextId     String?

  // 归属的 Chain
  chainId String
  chain   Chain  @relation(fields: [chainId], references: [id], onDelete: Cascade)

  // 引用子流程关系 (如果这个步骤是要调起另一个工作流模板)
  subChainId String?
  subChain   Chain?  @relation("childChain", fields: [subChainId], references: [id])

  instances StepInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainId])
}

model StepInstance {
  id     String @id @default(ulid())
  // 对应的是模板中的哪一个步骤
  stepId String
  step   Step   @relation(fields: [stepId], references: [id])

  // 归属的工作流实例
  chainInstanceId String
  chainInstance   ChainInstance @relation(fields: [chainInstanceId], references: [id], onDelete: Cascade)

  // 如果这个步骤运行时派生出了一个子流程，记录这个子流程实例的ID
  subChainInstanceId String?
  subChainInstance   ChainInstance? @relation("ParentStep", fields: [subChainInstanceId], references: [id])

  // 该步骤的执行状态：PENDING(未开始), READY(待认领), RUNNING(处理中), COMPLETED(完成), FAILED(异常), SKIPPED(跳过)
  status String @default("PENDING")

  // 用户在这一步真正填写产生的数据
  payload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainInstanceId])
  @@index([stepId])
  @@index([status])
}
